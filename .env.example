# ---------------------------------------------------------------------------
# Chromatic — environment variables
#
# Copy this file to `.env.local` for local development:
#
#     cp .env.example .env.local      # macOS / Linux
#     copy .env.example .env.local    # Windows
#
# `.env.local` is git-ignored. Never commit real secrets.
#
# The Prisma CLI reads `.env`, while Next.js reads `.env.local`. Keep both in
# sync locally, or put the same values in a single `.env` file.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
#
# Which Prisma provider to use.
#   sqlite      -> local development, one file, zero setup (default)
#   postgresql  -> production (Neon, Supabase, RDS, ...)
#
# `scripts/db-provider.mjs` rewrites `prisma/schema.prisma` to match.
DATABASE_PROVIDER=sqlite

# The connection string. SQLite paths are resolved relative to
# `prisma/schema.prisma`, so `file:./dev.db` becomes `prisma/dev.db`.
DATABASE_URL="file:./dev.db"

# Production example (PostgreSQL):
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?schema=public&sslmode=require"

# --- Application URL -------------------------------------------------------
#
# Used for password-reset links and metadata. In production set this to the
# public https URL of the deployment.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Password-reset e-mail (optional) --------------------------------------
#
# Without these the reset link is printed to the server log. In development it
# is also returned to the browser so the flow can be tested end-to-end.
# Create a key at https://resend.com/api-keys.
RESEND_API_KEY=""
EMAIL_FROM="Chromatic <onboarding@resend.dev>"
